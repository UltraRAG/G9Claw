<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19045.0</TargetPlatformMinVersion>
    <RootNamespace>G9Claw.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon />
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250907003" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\G9Claw.Windows.Core\G9Claw.Windows.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\9gclaw-logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\9gclaw-logo-white.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RemoveUnusedWebView2RuntimeFiles" AfterTargets="Build;Publish">
    <ItemGroup>
      <UnusedWebView2Runtime Include="$(OutputPath)Microsoft.Web.WebView2*.dll" />
      <UnusedWebView2Runtime Include="$(OutputPath)WebView2Loader.dll" />
      <UnusedWebView2Runtime Include="$(PublishDir)Microsoft.Web.WebView2*.dll" Condition="'$(PublishDir)' != ''" />
      <UnusedWebView2Runtime Include="$(PublishDir)WebView2Loader.dll" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(UnusedWebView2Runtime)" TreatErrorsAsWarnings="true" />
  </Target>

  <Target Name="CopyWinUIXamlPayloadToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <StaleWinUIXamlPublishPayload Include="$(PublishDir)WebV2Resources.xbf" />
    </ItemGroup>
    <Delete Files="@(StaleWinUIXamlPublishPayload)" TreatErrorsAsWarnings="true" />
    <RemoveDir Directories="$(PublishDir)publish" />
    <ItemGroup>
      <WinUIXamlPublishPayload Include="$(OutputPath)**\*.xbf" Exclude="$(OutputPath)publish\**\*;$(PublishDir)**\*" />
      <WinUIXamlPublishPayload Include="$(OutputPath)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy
      SourceFiles="@(WinUIXamlPublishPayload)"
      DestinationFiles="@(WinUIXamlPublishPayload->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
