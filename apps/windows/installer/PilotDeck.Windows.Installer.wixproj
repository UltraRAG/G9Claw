<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>PilotDeck.Windows.Setup</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <PublishDir>$(MSBuildThisFileDirectory)..\src\PilotDeck.Windows\bin\Release\net10.0-windows10.0.26100.0\win-x64\publish\</PublishDir>
    <DefineConstants>PublishDir=$(PublishDir)</DefineConstants>
    <SuppressIces>ICE03</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />

    <ProjectReference
      Include="..\src\PilotDeck.Windows\PilotDeck.Windows.csproj"
      ReferenceOutputAssembly="false"
      OutputItemType="Content"
      Targets="Publish"
      Properties="Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(PublishDir)" />
  </ItemGroup>
</Project>
